    "If enabled, effects will take the color of the current playing album, otherwise, it'll be white." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If enabled, effects will take the color of the current playing album, otherwise, it'll be white."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If enabled, effects will take the color of the current playing album, otherwise, it'll be white."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If enabled, effects will take the color of the current playing album, otherwise, it'll be white."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud je povoleno, efekty budou mít barvu aktuálního přehrávaného alba, v opačném případě budou bílé."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If enabled, effects will take the color of the current playing album, otherwise, it'll be white."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls aktiviert, werden die Effekte die Farbe des aktuellen Albums annehmen, andernfalls wird es weiß sein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν είναι ενεργοποιημένο, τα εφέ θα πάρουν το χρώμα του τρέχοντος άλμπουμ, διαφορετικά θα είναι λευκό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activo, los efectos tomaran el color del álbum que se está reproduciendo, de lo contrario, usará un color blanco."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If enabled, effects will take the color of the current playing album, otherwise, it'll be white."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si activé, les effets prendront la couleur de l'album en cours de lecture, sinon ils seront blancs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If enabled, effects will take the color of the current playing album, otherwise, it'll be white."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If enabled, effects will take the color of the current playing album, otherwise, it'll be white."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If enabled, effects will take the color of the current playing album, otherwise, it'll be white."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se attivato, gli effetti assumeranno il colore dell'album in riproduzione, altrimenti, saranno bianchi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、エフェクトは現在再生中のアルバムアートワークの色を模します。無効の場合は、白色のみになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성화하면 현재 재생중인 앨범의 색상이 효과에 반영됩니다. 비활성화 된 경우 흰색으로 나타납니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If enabled, effects will take the color of the current playing album, otherwise, it'll be white."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indien ingeschakeld nemen effecten de kleuren over van het huidige afgespeelde album, anders is het wit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli włączone, efekty będą miały kolor bieżącego albumu odtwarzanego, w przeciwnym razie będą białe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ativado, os efeitos tomarão a cor do álbum que está sendo reproduzido, caso contrário, será branco."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
