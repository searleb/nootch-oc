    "Soon you'll be able to compress images, zip/unzip files and much more by dragging and dropping files." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Soon you'll be able to compress images, zip/unzip files and much more by dragging and dropping files."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Soon you'll be able to compress images, zip/unzip files and much more by dragging and dropping files."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Soon you'll be able to compress images, zip/unzip files and much more by dragging and dropping files."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brzy budete moci komprimovat obrázky, rozbalovat a zipovat soubory a mnoho dalšího přetahováním souborů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Soon you'll be able to compress images, zip/unzip files and much more by dragging and dropping files."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bald können Sie Bilder komprimieren, Zip-Dateien entpacken und vieles mehr durch Ziehen und Ablegen von Dateien."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύντομα θα μπορείτε να συμπιέσετε εικόνες, να συμπιέσετε/αποσυμπιέσετε αρχεία και πολλά άλλα με μεταφορά και απόθεση αρχείων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pronto podrás comprimir imágenes, comprimir/descomprimir archivos y mucho más, solo arrastrando y soltando archivos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pian voit pakata kuvia, zipata/purkaa tiedostoja ja paljon muuta vetämällä ja pudottamalla tiedostoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bientôt vous pourrez compresser des images, zipper/dézipper des fichiers et bien plus en faisant glisser des fichiers."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Soon you'll be able to compress images, zip/unzip files and much more by dragging and dropping files."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Soon you'll be able to compress images, zip/unzip files and much more by dragging and dropping files."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Soon you'll be able to compress images, zip/unzip files and much more by dragging and dropping files."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presto sarai in grado di comprimere immagini, fare zip/unzip i file e molto altro ancora trascinando e rilasciando file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まもなく、ファイルをドラッグ＆ドロップで画像の圧縮、ファイルの圧縮/解凍など、さらに多くの機能が利用できるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "곧 드래그 앤 드롭으로 이미지를 압축하거나, 파일을 압축/해제할 수 있게 될거에요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snart kan du komprimere bilder, zip/unzip filer og mye mer ved å dra og slippe filer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binnenkort kunt u afbeeldingen comprimeren, bestanden zippen/unzippen en nog veel meer door bestanden te slepen en neer te zetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wkrótce będziesz mógł kompresować obrazy i pliki zip i wiele więcej, przeciągając i upuszczając pliki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em breve você poderá compactar imagens, arquivos zip/unzip e muito mais, arrastando e soltando arquivos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Soon you'll be able to compress images, zip/unzip files and much more by dragging and dropping files."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Soon you'll be able to compress images, zip/unzip files and much more by dragging and dropping files."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скоро Вы сможете сжимать изображения, архивировать файлы и делать многие другие действия при помощи перетаскивания файлов."
          }
        },
        "sk" : {
          "stringUnit" : {
