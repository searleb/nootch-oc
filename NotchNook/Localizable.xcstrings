    "Check your upcoming events in a lickable interface and fantastic haptics. Event editing and more will be coming soon..." : {
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Check your upcoming events in a lickable interface and fantastic haptics. Event editing and more will be coming soon..."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك التحقق من الأحداث القادمة من خلال واجهة سهلة الاستخدام ومؤثرات لمسية رائعة. سيتم تحرير الأحداث والمزيد قريبًا..."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Check your upcoming events in a lickable interface and fantastic haptics. Event editing and more will be coming soon..."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkontrolujte si nadcházející události v rozhraní, které jsou k nakousnutí, a s fantastickou haptikou. Úprava událostí a další funkce se objeví již brzy..."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Check your upcoming events in a lickable interface and fantastic haptics. Event editing and more will be coming soon..."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schau dir deine kommenden Events in einer schönen Oberfläche an und mit fantastischer Haptik. Editieren von Events und vieles mehr wird demnächst kommen..."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ελέγξτε τα επερχόμενα γεγονότα σας σε μια ελκυστική διεπαφή με φανταστική απτική αίσθηση. Η επεξεργασία γεγονότων και πολλά άλλα έρχονται σύντομα…"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta tus próximos eventos en una interfaz jugosa y con fantásticos efectos hápticos. La edición de eventos y más funciones llegarán pronto..."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista tulevat tapahtumat hienossa käyttöliittymässä ja upeilla haptiikoilla. Tapahtumien muokkaus ja paljon muuta tulossa pian..."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voir vos événements à venir dans une interface lisible avec des effets haptiques fantastiques. L'édition d'événements et plus encore seront bientôt disponibles..."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Check your upcoming events in a lickable interface and fantastic haptics. Event editing and more will be coming soon..."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Check your upcoming events in a lickable interface and fantastic haptics. Event editing and more will be coming soon..."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Check your upcoming events in a lickable interface and fantastic haptics. Event editing and more will be coming soon..."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla i tuoi eventi in programma tramite un'interfaccia piacevole con feedback aptici. La modifica degli eventi e molte altre funzionalità arriveranno prossimamente..."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "魅力的なインターフェースと素晴らしい触覚フィードバックに触れて、今後のイベントを確認しましょう。イベントの編集機能なども近日登場予定です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매력적인 인터페이스와 환상적인 햅틱 피드백으로 다가오는 이벤트를 확인하세요. 이벤트 편집 기능 등이 곧 공개될 예정입니다..."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjekk de kommende hendelsene i et klikk-basert grensesnitt, med fantastiske haptics. Arrangement redigering og flere egenskaper kommer snart..."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk je aankomende evenementen in een gebruiksvriendelijke interface en fantastische voelbare signalen. Evenementen bewerken en meer komen binnenkort..."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organizuj nadchodzące wydarzenia w pięknym interfejsie i z fantastyczną haptyką. Edycja wydarzeń i wiele więcej już wkrótce..."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique seus próximos eventos em uma interface fácil de usar e uma sensação tátil fantástica. Edição de eventos e muito mais estarão disponíveis em breve..."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique seus próximos eventos em uma interface lambiável e caprichos fantásticos. Edição de eventos e mais virá em breve..."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Check your upcoming events in a lickable interface and fantastic haptics. Event editing and more will be coming soon..."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следите за предстоящими событиями в приятном интерфейсе. Скоро появится редактирование событий и многое другое..."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Check your upcoming events in a lickable interface and fantastic haptics. Event editing and more will be coming soon..."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Check your upcoming events in a lickable interface and fantastic haptics. Event editing and more will be coming soon..."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Check your upcoming events in a lickable interface and fantastic haptics. Event editing and more will be coming soon..."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaklaşan etkinliklerini tıklanabilir bir arayüz ve harika dokunsal geri bildirimlerle kontrol et. Etkinlik düzenleme ve daha fazlası yakında gelecek..."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевірте свої майбутні події в зручному інтерфейсі та фантастичній тактильній панелі. Редагування подій та багато іншого буде незабаром..."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem các sự kiện sắp tới với giao diện hấp dẫn và phản hồi rung. Tính năng chỉnh sửa sự kiện và những tính năng khác sẽ có trong tương lai..."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在一个可爱的界面和奇妙的触觉反馈中检查你即将到来的事件。事件编辑和更多功能即将推出..."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在優美的介面中檢視即將到來的行程，即將推出編輯行程與其他更多的功能。"
          }
        }
      }
    },
