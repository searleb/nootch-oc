          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποτρέπει το NotchNook από το να κρυφτεί όταν είναι αδρανές. Χρήσιμο για εγγραφές οθόνης (δεν έχει επίδραση σε οθόνες χωρίς notch)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Previene que NotchNook se oculte cuando está inactivo. Útil para grabaciones de pantalla (esto no tiene efecto en pantallas sin notch)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estää NotchNookia piiloutumasta, kun se on käyttämättömänä. Hyödyllinen näytön tallennuksissa (tällä ei ole vaikutusta näytöissä, joissa ei ole notchia)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
